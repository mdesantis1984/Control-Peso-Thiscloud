# Copy from: .secrets.local.example
#
# Merged by scripts/deploy-production.ps1 (-f docker-compose.yml -f .secrets.local).
# POSTGRES_PASSWORD is not set here: compose reads it from the environment or a
# local .env file (see docs/DEPLOYMENT.md).

services:
  controlpeso-web:
    environment:
      - Authentication__Google__ClientId=CHANGE_ME_GOOGLE_CLIENT_ID_HERE
      - Authentication__Google__ClientSecret=CHANGE_ME_GOOGLE_CLIENT_SECRET_HERE
