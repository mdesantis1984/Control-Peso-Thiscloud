{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=controlpeso;Username=controlpeso_app;Password=CHANGE_ME_LOCAL"
  },
  "App": {
    "BaseUrl": "https://controlpeso.thiscloud.com.ar"
  },
  "Authentication": {
    "Google": {
      "ClientId": null,
      "ClientSecret": null
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": [ "127.0.0.0/8", "::1/128", "172.16.0.0/12", "192.168.178.0/24" ],
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Debug",
      "Microsoft.AspNetCore.Http.Connections": "Debug",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "ControlPeso.Shared.Resources": "Debug"
    },
    "SlowRequestThresholdMs": 1000
  },
  "AllowedHosts": "*",
  "GoogleAnalytics": {
    "MeasurementId": null
  },
  "PhotoStorage": {
    "WebRootPath": "wwwroot",
    "AvatarsFolder": "uploads/avatars"
  },
  "ThisCloud": {
    "Loggings": {
      "IsEnabled": true,
      "MinimumLevel": "Information",
      "Console": {
        "Enabled": true
      },
      "File": {
        "Enabled": true,
        "Path": "logs/controlpeso-.ndjson",
        "RollingFileSizeMb": 10,
        "RetainedFileCountLimit": 30,
        "UseCompactJson": true
      },
      "Redaction": {
        "Enabled": true
      },
      "Correlation": {
        "HeaderName": "X-Correlation-Id",
        "GenerateIfMissing": true
      }
    }
  }
}
